spring.application.name=sosang-workspace

# application.properties.example 을 복사해 application.properties 를 만들고 키를 넣으세요.

openai.api.key=

api.key.nts=
api.key.kamis=
api.key.smes=
api.key.bizinfo=
api.key.molit=
api.key.semas=
api.key.reb=

molit.api.key=${api.key.molit}
sbiz.api.key=${api.key.semas:}
rone.api.key=${api.key.reb}
smes.api.key=${api.key.smes}
bizinfo.api.key=${api.key.bizinfo:${api.key.smes}}
nts.api.key=${api.key.nts}
kamis.api.key=${api.key.kamis}
kamis.api.cert-id=2024

spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:3306/sosang_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

server.port=8081

app.auth.jwt.secret=${JWT_SECRET:sosang-workspace-jwt-secret-key-change-in-production-32bytes}
app.auth.jwt.expiration-ms=604800000
